# Copy this file to `.env` and paste in your own values.
#   cp .env.example .env
#
# Find both in Supabase: Project Settings → API
# `.env` is git-ignored — never commit real keys.
#
# The anon key is SAFE to ship in a browser app. It only grants what your
# Row Level Security policies allow, which for this project is nothing at
# all: results are saved through the submit-session function, not directly.
# Migration 006 removes the write permission browsers used to have.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Hosting ───────────────────────────────────────────────────
# Where the app will live. Leave blank for a domain of its own.
# For a subfolder (Hostinger and similar) set the folder, WITH both
# slashes, then rebuild:
#   VITE_BASE_PATH=/spot-the-scam/
VITE_BASE_PATH=

# The address printed on the shareable result card. Leave blank to use
# whatever address the app is being served from.
VITE_SHARE_URL=

# ── Optional extra bot check ─────────────────────────────────
# Leave blank. Abuse is handled by one-time tickets, timing checks and
# rate limiting inside the Edge Function, none of which need an account
# anywhere. If you ever get a Cloudflare account, put a Turnstile SITE
# key here and set TURNSTILE_SECRET_KEY on the function to add a layer.
VITE_TURNSTILE_SITE_KEY=
