# Copy this file to `.env` and paste in your own values.
#   cp .env.example .env
#
# Find both in Supabase: Project Settings → API
# `.env` is git-ignored — never commit real keys.
#
# The anon key is SAFE to ship in a browser app. It only grants what your
# Row Level Security policies allow, which for this project is "insert one
# quiz result, read nothing".

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
